{
  "name": "ocpp-cp-simulator",
  "description": "OCPP 1.6 / 2.0.1 / 2.1 charge point simulator: CLI daemon with a Socket.IO control plane, JSON-Lines mode, MCP endpoint, scenario engine and a bundled web console (runs on Bun)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiv3/ocpp-cp-simulator.git"
  },
  "homepage": "https://github.com/shiv3/ocpp-cp-simulator#readme",
  "bugs": "https://github.com/shiv3/ocpp-cp-simulator/issues",
  "keywords": [
    "ocpp",
    "ocpp-1.6",
    "ocpp-2.0.1",
    "ocpp-2.1",
    "charge-point",
    "ev-charging",
    "csms",
    "simulator",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "ocpp-cp-sim": "src/cli/main.ts"
  },
  "files": [
    "src/cli",
    "src/cp",
    "src/data",
    "src/ocpp",
    "src/protocol",
    "src/scenario",
    "src/trace",
    "src/utils",
    "schema",
    "vendor",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run && bun test bun.test",
    "test:vitest": "vitest run",
    "test:bun": "bun test bun.test",
    "test:bun:cli": "bun test src/cli/__tests__",
    "test:e2e": "bun run e2e/support/buildCsms.ts && bun test --timeout 60000 ./e2e/ocpp16.gocpp.e2e.ts ./e2e/ocpp201.gocpp.e2e.ts ./e2e/ocpp21.gocpp.e2e.ts ./e2e/scenario.gocpp.e2e.ts ./e2e/comprehensive.gocpp.e2e.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:bun": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=./coverage/bun bun.test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "prepack": "vite build",
    "postinstall": "node -e \"try{require('fs').chmodSync('src/cli/main.ts',0o755)}catch(e){}\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cli": "bun src/cli/main.ts",
    "fetch:ocpp": "bash scripts/fetch-ocpp-schemas.sh",
    "gen:ocpp": "bun run scripts/generate-ocpp.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@ocpp-debugkit/toolkit": "0.4.8",
    "@peculiar/x509": "^2.1.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@socket.io/bun-engine": "^0.1.2",
    "@tauri-apps/api": "^2.11.1",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "eventemitter2": "^6.4.9",
    "fast-xml-parser": "^5.11.1",
    "flowbite": "^4.0.2",
    "idb-keyval": "^6.3.0",
    "jotai": "^3.0.0",
    "jotai-zustand": "^0.6.0",
    "lucide-react": "^1.48.0",
    "mcp-lite": "^0.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-robot": "^1.2.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "robot3": "^1.2.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sql.js": "^1.14.2",
    "ws": "^8.21.3",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/eventemitter2": "^4.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "events": "^3.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json}": "prettier --write",
    "*.{ts,tsx}": "eslint --cache --fix"
  }
}
