{
  "id": "cert16-reservation-basic",
  "name": "Cert 1.6 Core: Reservation (Basic)",
  "description": "Parks waiting for ReserveNow.req (the CP core emits StatusNotification(Reserved) on Accepted); once the reserved idTag is presented, StatusNotification(Preparing) → StartTransaction.req (carries the reservationId) → StatusNotification(Charging) with bounded MeterValues.req → StopTransaction.req → StatusNotification(Finishing) → StatusNotification(Available).",
  "targetType": "connector",
  "targetId": 1,
  "trigger": { "type": "manual" },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 400, "y": 50 },
      "data": { "label": "Start", "triggerOn": "connect" }
    },
    {
      "id": "trigger-reservation",
      "type": "reservationTrigger",
      "position": { "x": 400, "y": 150 },
      "data": { "label": "Wait for ReserveNow", "timeout": 0 }
    },
    {
      "id": "delay-arrival",
      "type": "delay",
      "position": { "x": 400, "y": 350 },
      "data": { "label": "Reserved idTag arrives", "delaySeconds": 2 }
    },
    {
      "id": "tx-start",
      "type": "transaction",
      "position": { "x": 400, "y": 550 },
      "data": {
        "label": "Start Transaction",
        "action": "start",
        "tagId": "CERT-RES01"
      }
    },
    {
      "id": "meter-auto",
      "type": "meterValue",
      "position": { "x": 400, "y": 750 },
      "data": {
        "label": "Bounded Auto MeterValue",
        "value": 0,
        "sendMessage": true,
        "autoIncrement": true,
        "incrementInterval": 5,
        "incrementAmount": 500,
        "maxTime": 30,
        "maxValue": 0
      }
    },
    {
      "id": "tx-stop",
      "type": "transaction",
      "position": { "x": 400, "y": 850 },
      "data": { "label": "Stop Transaction", "action": "stop" }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 400, "y": 1150 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start-1", "target": "trigger-reservation" },
    {
      "id": "e2",
      "source": "trigger-reservation",
      "target": "delay-arrival"
    },
    { "id": "e4", "source": "delay-arrival", "target": "tx-start" },
    { "id": "e5", "source": "tx-start", "target": "meter-auto" },
    { "id": "e6", "source": "meter-auto", "target": "tx-stop" },
    { "id": "e7", "source": "tx-stop", "target": "end-1" }
  ],
  "ocppVersions": ["1.6"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "ReserveNow",
        "node": "trigger-reservation",
        "example": {
          "connectorId": 1,
          "expiryDate": "<now+3600s>",
          "idTag": "CERT-RES01",
          "reservationId": 1
        },
        "expectedStatus": "Accepted",
        "note": "idTag must be CERT-RES01: the template starts with that tag."
      }
    ]
  },
  "assertions": [
    {
      "id": "reserve-received",
      "type": "ocpp_received",
      "action": "ReserveNow",
      "description": "ReserveNow received from the CSMS"
    },
    {
      "id": "reserve-accepted",
      "type": "response_status",
      "action": "ReserveNow",
      "status": "Accepted",
      "description": "ReserveNow answered Accepted"
    },
    {
      "id": "started-with-reserved-tag",
      "type": "payload_match",
      "action": "StartTransaction",
      "payload": { "idTag": "CERT-RES01" },
      "description": "StartTransaction carries idTag CERT-RES01"
    },
    {
      "id": "start-after-reserve",
      "type": "message_after",
      "before": { "action": "ReserveNow", "direction": "received" },
      "after": { "action": "StartTransaction" },
      "description": "StartTransaction after ReserveNow"
    },
    {
      "id": "stop-after-start",
      "type": "message_after",
      "before": { "action": "StartTransaction" },
      "after": { "action": "StopTransaction" },
      "description": "StopTransaction after StartTransaction"
    }
  ]
}
