{
  "id": "cert16-tc010-remote-start",
  "name": "Cert 1.6 Core: TC_010 Remote Start Transaction",
  "description": "Plug in → StatusNotification(Preparing); CSMS sends RemoteStartTransaction → CP starts transaction with tag from request → StatusNotification(Charging); bounded MeterValues.req while charging.",
  "targetType": "connector",
  "targetId": 1,
  "trigger": { "type": "manual" },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 400, "y": 50 },
      "data": { "label": "Start", "triggerOn": "connect" }
    },
    {
      "id": "connector-plug-1",
      "type": "connectorPlug",
      "position": { "x": 400, "y": 150 },
      "data": { "label": "Plug In", "action": "plugin" }
    },
    {
      "id": "trigger-remote-start",
      "type": "remoteStartTrigger",
      "position": { "x": 400, "y": 350 },
      "data": { "label": "Wait for RemoteStartTransaction", "timeout": 0 }
    },
    {
      "id": "tx-start",
      "type": "transaction",
      "position": { "x": 400, "y": 450 },
      "data": {
        "label": "Start Transaction",
        "action": "start",
        "tagId": "CERT010"
      }
    },
    {
      "id": "meter-auto",
      "type": "meterValue",
      "position": { "x": 400, "y": 650 },
      "data": {
        "label": "Bounded Auto MeterValue",
        "value": 0,
        "sendMessage": true,
        "autoIncrement": true,
        "incrementInterval": 5,
        "incrementAmount": 500,
        "maxTime": 30,
        "maxValue": 0
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 400, "y": 750 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "start-1",
      "target": "connector-plug-1"
    },
    {
      "id": "e2",
      "source": "connector-plug-1",
      "target": "trigger-remote-start"
    },
    { "id": "e3", "source": "trigger-remote-start", "target": "tx-start" },
    { "id": "e4", "source": "tx-start", "target": "meter-auto" },
    { "id": "e5", "source": "meter-auto", "target": "end-1" }
  ],
  "ocppVersions": ["1.6"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "RemoteStartTransaction",
        "node": "trigger-remote-start",
        "example": { "connectorId": 1, "idTag": "CERT010" },
        "expectedStatus": "Accepted"
      }
    ]
  },
  "assertions": [
    {
      "id": "remote-start-received",
      "type": "ocpp_received",
      "action": "RemoteStartTransaction",
      "description": "RemoteStartTransaction received from the CSMS"
    },
    {
      "id": "remote-start-accepted",
      "type": "response_status",
      "action": "RemoteStartTransaction",
      "status": "Accepted",
      "description": "RemoteStartTransaction answered Accepted"
    },
    {
      "id": "started",
      "type": "payload_match",
      "action": "StartTransaction",
      "payload": { "idTag": "CERT010" },
      "description": "StartTransaction carries idTag CERT010"
    },
    {
      "id": "start-after-remote-start",
      "type": "message_after",
      "before": { "action": "RemoteStartTransaction", "direction": "received" },
      "after": { "action": "StartTransaction" },
      "description": "StartTransaction after RemoteStartTransaction"
    }
  ]
}
