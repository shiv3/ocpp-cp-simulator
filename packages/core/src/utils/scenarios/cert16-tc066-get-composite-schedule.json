{
  "id": "cert16-tc066-get-composite-schedule",
  "name": "Cert 1.6 SmartCharging: TC_066 Get Composite Schedule",
  "description": "Parks on SetChargingProfile, then on GetCompositeSchedule (two sequential csmsCallTrigger parks testing re-park path)",
  "targetType": "chargePoint",
  "trigger": { "type": "manual" },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 400, "y": 50 },
      "data": { "label": "Start", "triggerOn": "connect" }
    },
    {
      "id": "csms-set-charging-profile",
      "type": "csmsCallTrigger",
      "position": { "x": 400, "y": 250 },
      "data": {
        "label": "Wait for SetChargingProfile",
        "action": "SetChargingProfile",
        "timeout": 0
      }
    },
    {
      "id": "csms-get-composite-schedule",
      "type": "csmsCallTrigger",
      "position": { "x": 400, "y": 350 },
      "data": {
        "label": "Wait for GetCompositeSchedule",
        "action": "GetCompositeSchedule",
        "timeout": 0
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 400, "y": 450 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start-1", "target": "csms-set-charging-profile" },
    {
      "id": "e3",
      "source": "csms-set-charging-profile",
      "target": "csms-get-composite-schedule"
    },
    { "id": "e4", "source": "csms-get-composite-schedule", "target": "end-1" }
  ],
  "ocppVersions": ["1.6"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "SetChargingProfile",
        "node": "csms-set-charging-profile",
        "example": {
          "connectorId": 0,
          "csChargingProfiles": {
            "chargingProfileId": 11,
            "stackLevel": 0,
            "chargingProfilePurpose": "TxDefaultProfile",
            "chargingProfileKind": "Absolute",
            "chargingSchedule": {
              "chargingRateUnit": "W",
              "chargingSchedulePeriod": [{ "startPeriod": 0, "limit": 11000 }],
              "duration": 3600
            }
          }
        },
        "expectedStatus": "Accepted"
      },
      {
        "action": "GetCompositeSchedule",
        "node": "csms-get-composite-schedule",
        "example": {
          "connectorId": 1,
          "duration": 600,
          "chargingRateUnit": "W"
        },
        "expectedStatus": "Accepted"
      }
    ]
  },
  "assertions": [
    {
      "id": "profile-accepted",
      "type": "response_status",
      "action": "SetChargingProfile",
      "status": "Accepted",
      "description": "SetChargingProfile answered Accepted"
    },
    {
      "id": "composite-schedule-received",
      "type": "ocpp_received",
      "action": "GetCompositeSchedule",
      "description": "GetCompositeSchedule received from the CSMS"
    },
    {
      "id": "composite-accepted",
      "type": "response_status",
      "action": "GetCompositeSchedule",
      "status": "Accepted",
      "description": "GetCompositeSchedule answered Accepted"
    },
    {
      "id": "schedule-after-profile",
      "type": "message_order",
      "before": { "action": "SetChargingProfile", "direction": "received" },
      "after": { "action": "GetCompositeSchedule", "direction": "received" },
      "description": "GetCompositeSchedule after SetChargingProfile"
    }
  ]
}
