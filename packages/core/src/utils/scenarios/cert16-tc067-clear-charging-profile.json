{
  "id": "cert16-tc067-clear-charging-profile",
  "name": "Cert 1.6 SmartCharging: TC_067 Clear Charging Profile",
  "description": "CSMS sends SetChargingProfile; CP stores it. Then CSMS sends ClearChargingProfile; CP clears the stored profile and confirms Accepted.",
  "targetType": "chargePoint",
  "trigger": { "type": "manual" },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 400, "y": 50 },
      "data": { "label": "Start", "triggerOn": "connect" }
    },
    {
      "id": "csms-set-charging-profile",
      "type": "csmsCallTrigger",
      "position": { "x": 400, "y": 250 },
      "data": {
        "label": "Wait for SetChargingProfile",
        "action": "SetChargingProfile",
        "timeout": 0
      }
    },
    {
      "id": "csms-clear-charging-profile",
      "type": "csmsCallTrigger",
      "position": { "x": 400, "y": 350 },
      "data": {
        "label": "Wait for ClearChargingProfile",
        "action": "ClearChargingProfile",
        "timeout": 0
      }
    },
    {
      "id": "delay-2",
      "type": "delay",
      "position": { "x": 400, "y": 450 },
      "data": { "label": "Delay 2s", "delaySeconds": 2 }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 400, "y": 550 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start-1", "target": "csms-set-charging-profile" },
    {
      "id": "e3",
      "source": "csms-set-charging-profile",
      "target": "csms-clear-charging-profile"
    },
    {
      "id": "e4",
      "source": "csms-clear-charging-profile",
      "target": "delay-2"
    },
    { "id": "e5", "source": "delay-2", "target": "end-1" }
  ],
  "ocppVersions": ["1.6"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "SetChargingProfile",
        "node": "csms-set-charging-profile",
        "example": {
          "connectorId": 0,
          "csChargingProfiles": {
            "chargingProfileId": 11,
            "stackLevel": 0,
            "chargingProfilePurpose": "TxDefaultProfile",
            "chargingProfileKind": "Absolute",
            "chargingSchedule": {
              "chargingRateUnit": "W",
              "chargingSchedulePeriod": [{ "startPeriod": 0, "limit": 11000 }],
              "duration": 3600
            }
          }
        },
        "expectedStatus": "Accepted"
      },
      {
        "action": "ClearChargingProfile",
        "node": "csms-clear-charging-profile",
        "example": { "id": 11 },
        "expectedStatus": "Accepted"
      }
    ]
  },
  "assertions": [
    {
      "id": "profile-accepted",
      "type": "response_status",
      "action": "SetChargingProfile",
      "status": "Accepted",
      "description": "SetChargingProfile answered Accepted"
    },
    {
      "id": "clear-received",
      "type": "ocpp_received",
      "action": "ClearChargingProfile",
      "description": "ClearChargingProfile received from the CSMS"
    },
    {
      "id": "clear-accepted",
      "type": "response_status",
      "action": "ClearChargingProfile",
      "status": "Accepted",
      "description": "ClearChargingProfile answered Accepted"
    },
    {
      "id": "clear-after-set",
      "type": "message_order",
      "before": { "action": "SetChargingProfile", "direction": "received" },
      "after": { "action": "ClearChargingProfile", "direction": "received" },
      "description": "ClearChargingProfile after SetChargingProfile"
    }
  ]
}
