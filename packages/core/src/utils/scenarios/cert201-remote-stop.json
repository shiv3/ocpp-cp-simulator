{
  "id": "cert201-remote-stop",
  "name": "OCPP 2.x CP: Remote Stop Transaction",
  "description": "CP-side flow for OCPP 2.0.1 / 2.1: Remote Stop Transaction. The graph of cert16-tc012-remote-stop with 2.x payloads, CSMS expectations and assertions.",
  "targetType": "connector",
  "targetId": 1,
  "trigger": {
    "type": "manual"
  },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 400,
        "y": 50
      },
      "data": {
        "label": "Start",
        "triggerOn": "connect"
      }
    },
    {
      "id": "delay-connect",
      "type": "delay",
      "position": {
        "x": 400,
        "y": 150
      },
      "data": {
        "label": "Wait 2s",
        "delaySeconds": 2
      }
    },
    {
      "id": "plug-in",
      "type": "connectorPlug",
      "position": {
        "x": 400,
        "y": 250
      },
      "data": {
        "label": "Plug In",
        "action": "plugin"
      }
    },
    {
      "id": "tx-start",
      "type": "transaction",
      "position": {
        "x": 400,
        "y": 450
      },
      "data": {
        "label": "Start Transaction",
        "action": "start",
        "tagId": "CERT012"
      }
    },
    {
      "id": "meter-auto",
      "type": "meterValue",
      "position": {
        "x": 400,
        "y": 650
      },
      "data": {
        "label": "Auto MeterValue (until Remote Stop)",
        "value": 0,
        "sendMessage": true,
        "autoIncrement": true,
        "incrementInterval": 5,
        "incrementAmount": 500,
        "maxTime": 0,
        "maxValue": 0
      }
    },
    {
      "id": "trigger-remote-stop",
      "type": "remoteStopTrigger",
      "position": {
        "x": 400,
        "y": 750
      },
      "data": {
        "label": "Wait for RemoteStopTransaction",
        "timeout": 0
      }
    },
    {
      "id": "tx-stop",
      "type": "transaction",
      "position": {
        "x": 400,
        "y": 850
      },
      "data": {
        "label": "Stop Transaction",
        "action": "stop"
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": {
        "x": 400,
        "y": 1150
      },
      "data": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "start-1",
      "target": "delay-connect"
    },
    {
      "id": "e2",
      "source": "delay-connect",
      "target": "plug-in"
    },
    {
      "id": "e3",
      "source": "plug-in",
      "target": "tx-start"
    },
    {
      "id": "e4",
      "source": "tx-start",
      "target": "meter-auto"
    },
    {
      "id": "e5",
      "source": "meter-auto",
      "target": "trigger-remote-stop"
    },
    {
      "id": "e6",
      "source": "trigger-remote-stop",
      "target": "tx-stop"
    },
    {
      "id": "e7",
      "source": "tx-stop",
      "target": "end-1"
    }
  ],
  "ocppVersions": ["2.0.1", "2.1"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "RequestStopTransaction",
        "node": "trigger-remote-stop",
        "example": {
          "transactionId": "<transactionId>"
        },
        "expectedStatus": "Accepted"
      }
    ],
    "note": "The scenario starts the transaction itself (token CERT012); the CSMS stops it."
  },
  "assertions": [
    {
      "id": "started",
      "type": "payload_match",
      "action": "TransactionEvent",
      "payload": {
        "eventType": "Started",
        "idToken": {
          "idToken": "CERT012"
        }
      },
      "description": "TransactionEvent Started carries idToken CERT012",
      "occurrence": "any"
    },
    {
      "id": "remote-stop-accepted",
      "type": "response_status",
      "action": "RequestStopTransaction",
      "status": "Accepted",
      "description": "RequestStopTransaction answered Accepted"
    },
    {
      "id": "ended-remote",
      "type": "payload_match",
      "action": "TransactionEvent",
      "payload": {
        "eventType": "Ended",
        "transactionInfo": {
          "stoppedReason": "Remote"
        }
      },
      "description": "TransactionEvent Ended with stoppedReason Remote",
      "occurrence": "any"
    }
  ]
}
