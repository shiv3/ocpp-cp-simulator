      "action": "ReserveNow",
      "description": "ReserveNow received from the CSMS"
    },
    {
      "id": "reserve-faulted",
      "type": "response_status",
      "action": "ReserveNow",
      "status": "Faulted",
      "description": "ReserveNow answered Faulted"
    }
  ]
