  "ocppVersions": ["2.0.1", "2.1"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "ReserveNow",
        "node": "trigger-reserve-now",
        "example": {
          "id": 7,
          "expiryDateTime": "<now+3600s>",
          "idToken": {
            "idToken": "CERT-RES01",
            "type": "ISO14443"
          },
          "evseId": 1
        },
        "expectedStatus": "Faulted"
