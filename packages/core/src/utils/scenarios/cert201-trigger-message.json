{
  "id": "cert201-trigger-message",
  "name": "OCPP 2.x CP: Trigger Message",
  "description": "CP-side flow for OCPP 2.0.1 / 2.1: Trigger Message. The graph of cert16-tc054-trigger-message with 2.x payloads, CSMS expectations and assertions.",
  "targetType": "connector",
  "targetId": 1,
  "trigger": {
    "type": "manual"
  },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 400,
        "y": 50
      },
      "data": {
        "label": "Start",
        "triggerOn": "connect"
      }
    },
    {
      "id": "trigger-message",
      "type": "csmsCallTrigger",
      "position": {
        "x": 400,
        "y": 250
      },
      "data": {
        "label": "Wait for TriggerMessage",
        "action": "TriggerMessage",
        "timeout": 0
      }
    },
    {
      "id": "delay-cp-sends",
      "type": "delay",
      "position": {
        "x": 400,
        "y": 350
      },
      "data": {
        "label": "CP sends the requested message",
        "delaySeconds": 2
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": {
        "x": 400,
        "y": 450
      },
      "data": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "start-1",
      "target": "trigger-message"
    },
    {
      "id": "e3",
      "source": "trigger-message",
      "target": "delay-cp-sends"
    },
    {
      "id": "e4",
      "source": "delay-cp-sends",
      "target": "end-1"
    }
  ],
  "ocppVersions": ["2.0.1", "2.1"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "TriggerMessage",
        "node": "trigger-message",
        "example": {
          "requestedMessage": "StatusNotification",
          "evse": {
            "id": 1,
            "connectorId": 1
          }
        },
        "expectedStatus": "Accepted"
      }
    ]
  },
  "assertions": [
    {
      "id": "trigger-received",
      "type": "ocpp_received",
      "action": "TriggerMessage",
      "description": "TriggerMessage received from the CSMS"
    },
    {
      "id": "trigger-accepted",
      "type": "response_status",
      "action": "TriggerMessage",
      "status": "Accepted",
      "description": "TriggerMessage answered Accepted"
    },
    {
      "id": "status-after-trigger",
      "type": "message_after",
      "before": {
        "action": "TriggerMessage",
        "direction": "received"
      },
      "after": {
        "action": "StatusNotification"
      },
      "description": "StatusNotification after TriggerMessage"
    }
  ]
}
