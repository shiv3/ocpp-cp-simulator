{
  "id": "remote-start-auto-meter",
  "name": "Remote Start + Auto MeterValue",
  "description": "Wait RemoteStartTransaction → Start charging → AutoMeterValue",
  "targetType": "connector",
  "targetId": 1,
  "trigger": { "type": "manual" },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 400, "y": 50 },
      "data": { "label": "Start" }
    },
    {
      "id": "trigger-remote",
      "type": "remoteStartTrigger",
      "position": { "x": 400, "y": 150 },
      "data": { "label": "Wait RemoteStart", "timeout": 0 }
    },
    {
      "id": "transaction-start",
      "type": "transaction",
      "position": { "x": 400, "y": 350 },
      "data": {
        "label": "Start Transaction",
        "action": "start",
        "tagId": "REMOTE001"
      }
    },
    {
      "id": "meter-auto",
      "type": "meterValue",
      "position": { "x": 400, "y": 550 },
      "data": {
        "label": "Auto MeterValue",
        "value": 0,
        "sendMessage": true,
        "autoIncrement": true,
        "incrementInterval": 10,
        "incrementAmount": 1000,
        "maxValue": 0,
        "maxTime": 0
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 400, "y": 650 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    { "id": "e-start-remote", "source": "start-1", "target": "trigger-remote" },
    {
      "id": "e-remote-tx",
      "source": "trigger-remote",
      "target": "transaction-start"
    },
    {
      "id": "e-tx-meter",
      "source": "transaction-start",
      "target": "meter-auto"
    },
    { "id": "e-meter-end", "source": "meter-auto", "target": "end-1" }
  ],
  "ocppVersions": ["1.6"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "RemoteStartTransaction",
        "node": "trigger-remote",
        "example": { "connectorId": 1, "idTag": "REMOTE001" },
        "expectedStatus": "Accepted"
      }
    ],
    "note": "Ends when the transaction is stopped (RemoteStopTransaction or locally) or after 120 s of station time (maxDurationSeconds): the Auto MeterValue node has no limit of its own."
  },
  "assertions": [
    {
      "id": "remote-start-accepted",
      "type": "response_status",
      "action": "RemoteStartTransaction",
      "status": "Accepted",
      "description": "RemoteStartTransaction answered Accepted"
    },
    {
      "id": "started",
      "type": "payload_match",
      "action": "StartTransaction",
      "payload": { "idTag": "REMOTE001" },
      "description": "StartTransaction carries idTag REMOTE001"
    }
  ],
  "maxDurationSeconds": 120
}
