{
  "id": "resilience-communication-loss-recovery",
  "name": "Resilience: Communication Loss Recovery",
  "description": "Operator-driven. Cut the connection (network_sim.disconnect.trigger with a manual-disconnect rule, or any socket drop) while the connector is Available. The run waits for the drop and the reconnect, then for Available, and passes when the charge point booted again (BootNotification, then StatusNotification) after the loss.",
  "targetType": "connector",
  "targetId": 1,
  "trigger": {
    "type": "manual"
  },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 400,
        "y": 50
      },
      "data": {
        "label": "Start",
        "triggerOn": "connect"
      }
    },
    {
      "id": "wait-down",
      "type": "connectionTrigger",
      "position": {
        "x": 400,
        "y": 150
      },
      "data": {
        "label": "Wait for the connection to drop",
        "event": "disconnected",
        "timeout": 600
      }
    },
    {
      "id": "wait-up",
      "type": "connectionTrigger",
      "position": {
        "x": 400,
        "y": 250
      },
      "data": {
        "label": "Wait for the reconnect",
        "event": "connected",
        "timeout": 600
      }
    },
    {
      "id": "wait-available",
      "type": "statusTrigger",
      "position": {
        "x": 400,
        "y": 350
      },
      "data": {
        "label": "Wait for Available again",
        "targetStatus": "Available",
        "timeout": 120
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": {
        "x": 400,
        "y": 450
      },
      "data": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "start-1",
      "target": "wait-down"
    },
    {
      "id": "e2",
      "source": "wait-down",
      "target": "wait-up"
    },
    {
      "id": "e3",
      "source": "wait-up",
      "target": "wait-available"
    },
    {
      "id": "e4",
      "source": "wait-available",
      "target": "end-1"
    }
  ],
  "createdAt": "2026-11-08T00:00:00Z",
  "updatedAt": "2026-11-08T00:00:00Z",
  "assertions": [
    {
      "id": "rebooted",
      "type": "ocpp_sent",
      "action": "BootNotification",
      "description": "BootNotification sent again after the connection was lost (1.6 \u00a74.2; 2.x B01.FR.03)"
    },
    {
      "id": "status-after-boot",
      "type": "message_after",
      "before": {
        "action": "BootNotification"
      },
      "after": {
        "action": "StatusNotification"
      },
      "description": "Connector status reported after the reboot"
    }
  ]
}
