{
  "id": "resilience-temporary-unavailable-recovery-201",
  "name": "Resilience: Temporary Unavailable Recovery (OCPP 2.0.1 / 2.1)",
  "description": "Operator-driven. Send ChangeAvailability(Inoperative) then ChangeAvailability(Operative) for the connector. Passes when both calls arrived and the connector reported Unavailable and then Available (OCPP 1.6 payload checks for the statuses). OCPP 2.0.1 / 2.1 variant: same flow, 2.x payloads and assertions.",
  "targetType": "connector",
  "targetId": 1,
  "trigger": {
    "type": "manual"
  },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 400,
        "y": 50
      },
      "data": {
        "label": "Start",
        "triggerOn": "connect"
      }
    },
    {
      "id": "wait-inop",
      "type": "csmsCallTrigger",
      "position": {
        "x": 400,
        "y": 150
      },
      "data": {
        "label": "Wait for ChangeAvailability (Inoperative)",
        "action": "ChangeAvailability",
        "timeout": 600
      }
    },
    {
      "id": "wait-unavailable",
      "type": "statusTrigger",
      "position": {
        "x": 400,
        "y": 250
      },
      "data": {
        "label": "Wait for Unavailable",
        "targetStatus": "Unavailable",
        "timeout": 60
      }
    },
    {
      "id": "wait-op",
      "type": "csmsCallTrigger",
      "position": {
        "x": 400,
        "y": 350
      },
      "data": {
        "label": "Wait for ChangeAvailability (Operative)",
        "action": "ChangeAvailability",
        "timeout": 600
      }
    },
    {
      "id": "wait-available",
      "type": "statusTrigger",
      "position": {
        "x": 400,
        "y": 450
      },
      "data": {
        "label": "Wait for Available",
        "targetStatus": "Available",
        "timeout": 60
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": {
        "x": 400,
        "y": 550
      },
      "data": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "start-1",
      "target": "wait-inop"
    },
    {
      "id": "e2",
      "source": "wait-inop",
      "target": "wait-unavailable"
    },
    {
      "id": "e3",
      "source": "wait-unavailable",
      "target": "wait-op"
    },
    {
      "id": "e4",
      "source": "wait-op",
      "target": "wait-available"
    },
    {
      "id": "e5",
      "source": "wait-available",
      "target": "end-1"
    }
  ],
  "createdAt": "2026-11-08T00:00:00Z",
  "updatedAt": "2026-11-08T00:00:00Z",
  "ocppVersions": ["2.0.1", "2.1"],
  "csmsExpectations": {
    "calls": [
      {
        "action": "ChangeAvailability",
        "node": "wait-inop",
        "example": {
          "operationalStatus": "Inoperative",
          "evse": {
            "id": 1
          }
        },
        "expectedStatus": "Accepted"
      },
      {
        "action": "ChangeAvailability",
        "node": "wait-op",
        "example": {
          "operationalStatus": "Operative",
          "evse": {
            "id": 1
          }
        },
        "expectedStatus": "Accepted"
      }
    ]
  },
  "assertions": [
    {
      "id": "inoperative-accepted",
      "type": "response_status",
      "action": "ChangeAvailability",
      "status": "Accepted",
      "description": "ChangeAvailability answered Accepted"
    },
    {
      "id": "unavailable",
      "type": "state_transition",
      "targetStatus": "Unavailable",
      "description": "connector reaches Unavailable"
    },
    {
      "id": "operative-accepted",
      "type": "response_status",
      "action": "ChangeAvailability",
      "status": "Accepted",
      "description": "ChangeAvailability answered Accepted",
      "occurrence": 1
    },
    {
      "id": "available-again",
      "type": "state_transition",
      "targetStatus": "Available",
      "description": "connector reaches Available"
    }
  ]
}
