{
  "id": "smart-charging",
  "name": "Smart Charging (Auto MeterValue)",
  "description": "Auto-increment MeterValue when Charging, stop when Finishing",
  "targetType": "connector",
  "targetId": 1,
  "trigger": {
    "type": "manual"
  },
  "defaultExecutionMode": "oneshot",
  "enabled": true,
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": {
        "x": 400,
        "y": 50
      },
      "data": {
        "label": "Start"
      }
    },
    {
      "id": "trigger-charging",
      "type": "statusTrigger",
      "position": {
        "x": 400,
        "y": 150
      },
      "data": {
        "label": "Wait for Charging",
        "targetStatus": "Charging",
        "timeout": 0
      }
    },
    {
      "id": "fork-1",
      "type": "parallel",
      "position": {
        "x": 400,
        "y": 250
      },
      "data": {
        "label": "Fork"
      }
    },
    {
      "id": "meter-auto",
      "type": "meterValue",
      "position": {
        "x": 250,
        "y": 350
      },
      "data": {
        "label": "Start Auto MeterValue",
        "value": 0,
        "sendMessage": true,
        "autoIncrement": true,
        "incrementInterval": 10,
        "incrementAmount": 1000,
        "maxValue": 30000,
        "maxTime": 0
      }
    },
    {
      "id": "trigger-finish",
      "type": "statusTrigger",
      "position": {
        "x": 550,
        "y": 350
      },
      "data": {
        "label": "Wait for Finishing",
        "targetStatus": "Finishing",
        "timeout": 0
      }
    },
    {
      "id": "join-1",
      "type": "join",
      "position": {
        "x": 400,
        "y": 550
      },
      "data": {
        "label": "Join (all)",
        "mode": "all"
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": {
        "x": 400,
        "y": 650
      },
      "data": {
        "label": "End"
      }
    }
  ],
  "edges": [
    {
      "id": "e-start-charging",
      "source": "start-1",
      "target": "trigger-charging"
    },
    {
      "id": "e-charging-fork",
      "source": "trigger-charging",
      "target": "fork-1"
    },
    {
      "id": "e-fork-meter",
      "source": "fork-1",
      "target": "meter-auto"
    },
    {
      "id": "e-fork-finish",
      "source": "fork-1",
      "target": "trigger-finish"
    },
    {
      "id": "e-meter-join",
      "source": "meter-auto",
      "target": "join-1"
    },
    {
      "id": "e-finish-join",
      "source": "trigger-finish",
      "target": "join-1"
    },
    {
      "id": "e-join-end",
      "source": "join-1",
      "target": "end-1"
    }
  ],
  "ocppVersions": ["1.6"],
  "csmsExpectations": {
    "calls": [],
    "simulatorSteps": [
      {
        "command": "ev_plug_in",
        "params": { "connector": 1 },
        "node": "trigger-charging"
      },
      {
        "command": "start_transaction",
        "params": { "connector": 1, "tagId": "SC-TAG" },
        "node": "trigger-charging"
      },
      {
        "command": "stop_transaction",
        "params": { "connector": 1 },
        "node": "trigger-finish"
      }
    ],
    "note": "No CSMS action; the Charging / Finishing status triggers are driven by simulator commands. Ends when the connector reaches Finishing, or after 120 s of station time (maxDurationSeconds)."
  },
  "assertions": [
    {
      "id": "charging",
      "type": "state_transition",
      "targetStatus": "Charging",
      "description": "connector reaches Charging"
    },
    {
      "id": "finishing",
      "type": "state_transition",
      "targetStatus": "Finishing",
      "description": "connector reaches Finishing"
    },
    {
      "id": "stopped",
      "type": "ocpp_sent",
      "action": "StopTransaction",
      "description": "StopTransaction sent"
    }
  ],
  "maxDurationSeconds": 120
}
