{
  "name": "@ocpp-cp-simulator/ocpp",
  "version": "0.0.0",
  "private": false,
  "description": "OCPP 1.6, 2.0.1 and 2.1 message types, JSON schemas, Ajv validators and enums generated from the OCA JSON schemas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiv3/ocpp-cp-simulator.git",
    "directory": "packages/ocpp"
  },
  "keywords": [
    "ocpp",
    "ocpp-1.6",
    "ocpp-2.0.1",
    "ocpp-2.1",
    "json-schema",
    "ev-charging"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./v16": "./src/v16/index.ts",
    "./v201": "./src/v201/index.ts",
    "./v21": "./src/v21/index.ts",
    "./validation": "./src/validation/index.ts",
    "./schema-sources": "./src/schemaSources.ts",
    "./v16/types/*": "./src/v16/types/*.ts",
    "./v201/types/*": "./src/v201/types/*.ts",
    "./v21/types/*": "./src/v21/types/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./v16": {
        "types": "./lib/v16/index.d.ts",
        "default": "./lib/v16/index.js"
      },
      "./v201": {
        "types": "./lib/v201/index.d.ts",
        "default": "./lib/v201/index.js"
      },
      "./v21": {
        "types": "./lib/v21/index.d.ts",
        "default": "./lib/v21/index.js"
      },
      "./validation": {
        "types": "./lib/validation/index.d.ts",
        "default": "./lib/validation/index.js"
      },
      "./schema-sources": {
        "types": "./lib/schemaSources.d.ts",
        "default": "./lib/schemaSources.js"
      },
      "./v16/types/*": {
        "types": "./lib/v16/types/*.d.ts",
        "default": "./lib/v16/types/*.js"
      },
      "./v201/types/*": {
        "types": "./lib/v201/types/*.d.ts",
        "default": "./lib/v201/types/*.js"
      },
      "./v21/types/*": {
        "types": "./lib/v21/types/*.d.ts",
        "default": "./lib/v21/types/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-ocpp-package.ts",
    "prepack": "echo 'packages/ocpp is the workspace form (TypeScript sources): run bun run build and pack packages/ocpp/dist' >&2 && exit 1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0"
  }
}
