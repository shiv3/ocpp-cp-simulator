{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.bench.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,

    "types": ["bun-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `composite` (this project is referenced from the root tsconfig, so it is
  // built rather than orphaned) requires every file in the program to be
  // listed. The two files borrowed from src/ are CP_CREATE_MANY_MAX (the
  // batch size `cp.create_many` accepts) and the OCPP version list
  // `--ocpp-version` validates against — both dependency-free constants.
  "include": [
    "**/*.ts",
    "../../src/protocol/limits.ts",
    "../../src/cp/domain/types/OcppVersion.ts"
  ]
}
