{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // The repository tooling that checks the source tree itself. Listed
  // explicitly (composite projects need every file named): the rest of
  // scripts/ is either shell or has its own project (bench/).
  "include": [
    "check-package-boundaries.ts",
    "__tests__/checkPackageBoundaries.bun.test.ts"
  ]
}
