{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cli.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Types */
    "types": ["bun-types"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "apps/cli/src",
    "packages/core/src/cp",
    "packages/client/src/configPort.ts",
    "packages/client/src/interfaces/ChargePointService.ts",
    "packages/client/src/interfaces/ConfigRepository.ts",
    "packages/client/src/interfaces/ConnectorSettingsRepository.ts",
    "packages/client/src/remote/RemoteChargePointService.ts",
    "packages/client/src/sqlite/SqliteConnectorSettingsRepository.ts",
    "packages/ocpp/src",
    "packages/contracts/src",
    "packages/core/src/scenario",
    "packages/core/src/test/bunServe.ts",
    "packages/core/src/test/deferred.ts",
    "packages/core/src/test/scenarioRunFixtures.ts",
    "packages/core/src/test/chargingSessionFixtures.ts",
    "packages/trace/src",
    "packages/core/src/types",
    "packages/core/src/utils/blueprints",
    "packages/core/src/utils/scenarioTemplates.ts"
  ]
}
